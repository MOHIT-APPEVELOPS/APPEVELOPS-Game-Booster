<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0B"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Animations Setting"
        android:textColor="#FF0055"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Switch
        android:id="@+id/switchAnimationEnable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Enable Animation Tweaks"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Window Animation Scale"
        android:textColor="#CCCCCC" />

    <Spinner
        android:id="@+id/spinnerWindowAnim"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="#1F1F1F" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Transition Animation Scale"
        android:textColor="#CCCCCC" />

    <Spinner
        android:id="@+id/spinnerTransitionAnim"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="#1F1F1F" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Animation Duration Scale"
        android:textColor="#CCCCCC" />

    <Spinner
        android:id="@+id/spinnerAnimatorAnim"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="#1F1F1F" />

</LinearLayout>
