<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0B"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DND &amp; Notification Settings"
        android:textColor="#FF0055"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Switch
        android:id="@+id/switchDndService"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Enable DND Service"
        android:textColor="#FFFFFF" />

    <Switch
        android:id="@+id/switchMsgSilent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Silence Incoming Messages"
        android:textColor="#FFFFFF" />

    <Switch
        android:id="@+id/switchCallDnd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Block / Silence Calls"
        android:textColor="#FFFFFF" />

</LinearLayout>
