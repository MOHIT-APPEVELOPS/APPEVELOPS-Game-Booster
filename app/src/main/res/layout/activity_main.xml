<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0B"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEON GAME BOOSTER"
            android:textColor="#FF0055"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Secure • Non-Root • Anti-Ban"
            android:textColor="#888888"
            android:textSize="12sp" />

        <!-- Shizuku Engine Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1A1A1A"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shizuku Engine: Checking..."
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnConnectShizuku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Connect Shizuku" />
        </LinearLayout>

        <!-- Select Games/Apps Button -->
        <Button
            android:id="@+id/btnSelectApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#1F1F1F"
            android:text="Select Games / APPS"
            android:textColor="#FFFFFF" />

        <!-- Feature Switches -->
        <Switch
            android:id="@+id/switchVpn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="VPN Ping Isolation"
            android:textColor="#FFFFFF" />

        <Switch
            android:id="@+id/switchCrosshair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Floating Crosshair"
            android:textColor="#FFFFFF" />

        <!-- Sub-menu Buttons -->
        <Button
            android:id="@+id/btnDndSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#2A2A2A"
            android:text="DND Services Setting ➔"
            android:textColor="#FF0055" />

        <Button
            android:id="@+id/btnAnimationSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2A2A2A"
            android:text="Animation Setting ➔"
            android:textColor="#FF0055" />

        <!-- System Optimizations -->
        <Switch
            android:id="@+id/switchBgAppKiller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Background App Killer"
            android:textColor="#FFFFFF" />

        <Switch
            android:id="@+id/switchCacheClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cache Clear"
            android:textColor="#FFFFFF" />

        <Switch
            android:id="@+id/switchSystemBoost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="System Boost"
            android:textColor="#FFFFFF" />

        <Switch
            android:id="@+id/switchBatteryOptimization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Disable Battery Restriction"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnToggleBoost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#FF0055"
            android:padding="14dp"
            android:text="START SERVICES"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSelectedGames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
