<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0E15"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEON GAME BOOSTER"
        android:textColor="#FF0055"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Secure • Non-Root • Anti-Ban"
        android:textColor="#A0A5BD"
        android:textSize="12sp" />

    <!-- Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161823"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYSTEM STATUS"
            android:textColor="#FF0055"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Checking Engine Status..."
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Select Apps Button -->
    <Button
        android:id="@+id/btnSelectApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#161823"
        android:text="SELECT GAMES / APPS"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Features Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161823"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <!-- VPN Switch -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchVpn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VPN Ping Isolation"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="6dp" />

        <!-- Crosshair Switch -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchCrosshair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Floating Crosshair"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="6dp" />

        <!-- Window Animation Scale Switch -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchWindowAnim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Window Animation Scale (0.1x)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="6dp" />

        <!-- Transition Animation Scale Switch -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchTransitionAnim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Transition Animation Scale (0.1x)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="6dp" />

        <!-- Animator Duration Scale Switch -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAnimatorAnim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Animator Duration Scale (0.1x)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="6dp" />

    </LinearLayout>

    <!-- Start Booster Service Button -->
    <Button
        android:id="@+id/btnToggleBoost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#FF0055"
        android:text="START BOOSTER SERVICE"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SELECTED GAMES DASHBOARD"
        android:textColor="#A0A5BD"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Selected Games List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSelectedGames"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
